<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFF0F4">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorPrimary"
        android:paddingHorizontal="8dp"
        android:paddingVertical="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Volver" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/acciones_title"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginStart="4dp" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- Row 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btn_palabras"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="4dp"
                    app:cardBackgroundColor="@color/btnPalabras"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:gravity="center" android:padding="12dp">
                        <ImageView android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_palabras"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/accion_palabras" android:textSize="12sp" android:textStyle="bold"
                            android:gravity="center" android:layout_marginTop="6dp" android:textColor="#880E4F"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/req_palabras" android:textSize="10sp" android:textColor="#888888" android:gravity="center"/>
                        <TextView android:id="@+id/tv_status_palabras" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="❌ Pendiente"
                            android:textSize="11sp" android:textStyle="bold" android:layout_marginTop="6dp"
                            android:textColor="#B71C1C" android:gravity="center"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btn_dulces"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="4dp"
                    app:cardBackgroundColor="@color/btnDulces"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:gravity="center" android:padding="12dp">
                        <ImageView android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_dulces"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/accion_dulces" android:textSize="12sp" android:textStyle="bold"
                            android:gravity="center" android:layout_marginTop="6dp" android:textColor="#4E342E"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/req_dulces" android:textSize="10sp" android:textColor="#888888" android:gravity="center"/>
                        <TextView android:id="@+id/tv_status_dulces" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="❌ Pendiente"
                            android:textSize="11sp" android:textStyle="bold" android:layout_marginTop="6dp"
                            android:textColor="#B71C1C" android:gravity="center"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- Row 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btn_flores"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="4dp"
                    app:cardBackgroundColor="@color/btnFlores"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:gravity="center" android:padding="12dp">
                        <ImageView android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_flores"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/accion_flores" android:textSize="12sp" android:textStyle="bold"
                            android:gravity="center" android:layout_marginTop="6dp" android:textColor="#880E4F"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/req_flores" android:textSize="10sp" android:textColor="#888888" android:gravity="center"/>
                        <TextView android:id="@+id/tv_status_flores" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="❌ Pendiente"
                            android:textSize="11sp" android:textStyle="bold" android:layout_marginTop="6dp"
                            android:textColor="#B71C1C" android:gravity="center"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btn_flores_grandes"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="4dp"
                    app:cardBackgroundColor="@color/btnFloresGrandes"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:gravity="center" android:padding="12dp">
                        <ImageView android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_flores_grandes"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/accion_flores_grandes" android:textSize="12sp" android:textStyle="bold"
                            android:gravity="center" android:layout_marginTop="6dp" android:textColor="#6A1B9A"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/req_flores_grandes" android:textSize="10sp" android:textColor="#888888" android:gravity="center"/>
                        <TextView android:id="@+id/tv_status_flores_grandes" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="❌ Pendiente"
                            android:textSize="11sp" android:textStyle="bold" android:layout_marginTop="6dp"
                            android:textColor="#B71C1C" android:gravity="center"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- Row 3 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btn_joyeria"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="4dp"
                    app:cardBackgroundColor="@color/btnJoyeria"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:gravity="center" android:padding="12dp">
                        <ImageView android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_joyeria"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/accion_joyeria" android:textSize="12sp" android:textStyle="bold"
                            android:gravity="center" android:layout_marginTop="6dp" android:textColor="#E65100"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/req_joyeria" android:textSize="10sp" android:textColor="#888888" android:gravity="center"/>
                        <TextView android:id="@+id/tv_status_joyeria" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="❌ Pendiente"
                            android:textSize="11sp" android:textStyle="bold" android:layout_marginTop="6dp"
                            android:textColor="#B71C1C" android:gravity="center"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btn_salida"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="4dp"
                    app:cardBackgroundColor="@color/btnSalida"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:gravity="center" android:padding="12dp">
                        <ImageView android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_salida"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/accion_salida" android:textSize="12sp" android:textStyle="bold"
                            android:gravity="center" android:layout_marginTop="6dp" android:textColor="#1565C0"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/req_salida" android:textSize="10sp" android:textColor="#888888" android:gravity="center"/>
                        <TextView android:id="@+id/tv_status_salida" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="❌ Pendiente"
                            android:textSize="11sp" android:textStyle="bold" android:layout_marginTop="6dp"
                            android:textColor="#B71C1C" android:gravity="center"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <Button
                android:id="@+id/btn_listo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/listo_btn"
                android:backgroundTint="@color/colorPrimary"
                android:textStyle="bold"
                android:textSize="16sp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
